{
  "name": "@lipoe/browser-qpdf",
  "version": "0.2.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Browser-compatible WASM module exposing qpdf's library API for reading and replacing PDF image streams",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./qpdf-image-stream.wasm": "./dist/qpdf-image-stream.wasm"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/types.d.ts",
    "dist/qpdf-image-stream.js",
    "dist/qpdf-image-stream.wasm",
    "THIRD-PARTY-NOTICES"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "build:wasm": "docker build -t qpdf-wasm-builder . && docker run --rm -v \"$PWD/dist:/out\" qpdf-wasm-builder",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:pbt": "vitest run test/pbt",
    "test:browser": "npm run build && playwright test",
    "test:all": "npm run build && vitest run && playwright test",
    "test:watch": "vitest",
    "fixtures:encrypted": "node test/fixtures/generate-encrypted-fixtures.mjs",
    "playground": "npx --yes serve ."
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "fast-check": "^3.19.0",
    "playwright": "^1.44.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
